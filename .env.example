# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 제출물에 넣지 마세요.

# 제주데이터허브 계정 (데이터 이용신청·다운로드 자동화용, 선택)
JEJUDATAHUB_ID=
JEJUDATAHUB_PW=
# 허브 내 프로젝트 화면에 표시되는 프로젝트 키 (API형 데이터 호출용)
JEJUDATAHUB_PROJECT_KEY=

# LLM (Agent)
ANTHROPIC_API_KEY=
# 선택: 모델과 추론 강도 (기본 claude-opus-5-5 / medium)
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
# 선택: 사용자 유형별 모델 (비용 조절). 평가 결과는 개발진행.md '모델별 품질·비용 비교' 참고
CLAUDE_MODEL_OWNER=claude-sonnet-5-5
CLAUDE_MODEL_TOURIST=claude-haiku-5-5

# Google Gemini (나노바나나 이미지 생성: 홍보 카드 배경, 선택)
GEMINI_API_KEY=

# 네이버 클라우드 플랫폼 Maps (지도, Geocoding, Directions)
NCP_CLIENT_ID=
NCP_CLIENT_SECRET=

# 네이버 개발자센터 검색 API (지역 검색 → 네이버 등록 여부 판별)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 공공데이터포털 (지방행정 인허가 API, 기상청 단기예보)
DATA_GO_KR_SERVICE_KEY=

# 실행 모드: hub(허브 데이터) / center(빅데이터센터 PC, 반출불가 데이터 사용)
DATA_MODE=hub
